{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset_manifest.schema.json",
  "title": "Brainrot Massacre asset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "characters"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "characters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/character"
      }
    }
  },
  "$defs": {
    "nullableString": {
      "type": ["string", "null"]
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "intactAssetName",
        "fracturedAssetName",
        "sourceHoudiniFile",
        "fbxFiles",
        "robloxAssets",
        "version",
        "import",
        "assemblyOriginConvention",
        "materials"
      ],
      "properties": {
        "identifier": {
          "type": "string"
        },
        "intactAssetName": {
          "type": "string"
        },
        "fracturedAssetName": {
          "type": "string"
        },
        "sourceHoudiniFile": {
          "type": "string"
        },
        "fbxFiles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["intact", "fractured"],
          "properties": {
            "intact": {
              "type": "string"
            },
            "fractured": {
              "type": "string"
            }
          }
        },
        "robloxAssets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["intact", "fractured"],
          "properties": {
            "intact": {
              "$ref": "#/$defs/nullableString"
            },
            "fractured": {
              "$ref": "#/$defs/nullableString"
            }
          }
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "import": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceUnit", "scale", "targetHeightStuds", "forwardAxis", "upAxis"],
          "properties": {
            "sourceUnit": {
              "type": "string"
            },
            "scale": {
              "type": ["number", "null"],
              "exclusiveMinimum": 0
            },
            "targetHeightStuds": {
              "type": ["number", "null"],
              "exclusiveMinimum": 0
            },
            "forwardAxis": {
              "$ref": "#/$defs/nullableString"
            },
            "upAxis": {
              "$ref": "#/$defs/nullableString"
            }
          }
        },
        "assemblyOriginConvention": {
          "$ref": "#/$defs/nullableString"
        },
        "materials": {
          "type": "object",
          "additionalProperties": false,
          "required": ["outer", "inner"],
          "properties": {
            "outer": {
              "$ref": "#/$defs/nullableString"
            },
            "inner": {
              "$ref": "#/$defs/nullableString"
            }
          }
        }
      }
    }
  }
}
